{
  "name": "cqai-dsh-plugin-xiaobao",
  "version": "0.1.0",
  "description": "e销宝：面向小团队、服务 C 端客户的实时销售话术 Copilot。",
  "icon": "assets/icon.svg",
  "license": "MIT",
  "homepage": "https://github.com/cqai-club/cqai-dsh-plugin-xiaobao#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqai-club/cqai-dsh-plugin-xiaobao.git"
  },
  "bugs": {
    "url": "https://github.com/cqai-club/cqai-dsh-plugin-xiaobao/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sales",
    "sales-coach",
    "realtime",
    "copilot",
    "b2c"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "assets",
    "data",
    "docs",
    "fixtures",
    "scripts",
    "test",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "seed": "node scripts/build-seed.mjs",
    "fixtures": "node scripts/build-fixtures.mjs",
    "test": "node --test-isolation=none --test \"test/*.test.mjs\"",
    "eval": "node scripts/eval.mjs",
    "check": "node scripts/selfcheck.mjs",
    "prepublishOnly": "node scripts/selfcheck.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
